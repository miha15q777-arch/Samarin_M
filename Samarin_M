import tkinter as tk
from tkinter import ttk, messagebox, simpledialog
import json
import os
import random
import string
from datetime import datetime

# --- Настройки ---
HISTORY_FILE = "history.json"
MIN_LENGTH = 4
MAX_LENGTH = 128

class PasswordGeneratorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Генератор Паролей")
        self.root.geometry("500x450")
        self.root.resizable(False, False)
        
        self.history = self.load_history()
        self.create_widgets()

    # --- Работа с историей (JSON) ---
    def load_history(self):
        """Загрузка истории из файла."""
        if os.path.exists(HISTORY_FILE):
            try:
                with open(HISTORY_FILE, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except (json.JSONDecodeError, IOError):
                return []
        return []

    def save_history(self):
        """Сохранение истории в файл."""
        try:
            with open(HISTORY_FILE, 'w', encoding='utf-8') as f:
                json.dump(self.history, f, ensure_ascii=False, indent=4)
        except IOError as e:
            messagebox.showerror("Ошибка сохранения", "Не удалось сохранить историю паролей.")

    def add_to_history(self, password):
        """Добавление пароля в историю."""
        entry = {
            "password": password,
            "date": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        }
        self.history.insert(0, entry) # Добавляем в начало списка
        
        # Ограничиваем историю последними 20 записями, чтобы файл не разрастался
        if len(self.history) > 20:
            self.history = self.history[:20]
            
        self.save_history()
        self.update_history_display()

    # --- Логика генерации ---
    def generate_password(self):
        """Генерирует пароль на основе выбранных настроек."""
        length = self.length_slider.get()
        
        # Валидация: хотя ползунок ограничивает значения, проверка не помешает
        if length < MIN_LENGTH or length > MAX_LENGTH:
            messagebox.showerror("Ошибка", f"Длина пароля должна быть от {MIN_LENGTH} до {MAX_LENGTH} символов.")
            return

        # Сбор наборов символов на основе чекбоксов
        char_sets = []
        if self.use_upper.get():
            char_sets.append(string.ascii_uppercase)
        if self.use_lower.get():
            char_sets.append(string.ascii_lowercase)
        if self.use_digits.get():
            char_sets.append(string.digits)
        if self.use_punct.get():
            char_sets.append(string.punctuation)
        
        # Валидация: должен быть выбран хотя бы один набор символов
        if not char_sets:
            messagebox.showwarning("Выбор символов", "Пожалуйста, выберите хотя бы один тип символов для генерации.")
            return

        # Создание пула доступных символов
        all_chars = ''.join(char_sets)
        
        # Генерация: гарантируем наличие хотя бы одного символа из каждого выбранного набора
        password_chars = [random.choice(charset) for charset in char_sets]
        
        # Дополняем пароль до нужной длины случайными символами из общего пула
        password_chars += [random.choice(all_chars) for _ in range(length - len(password_chars))]
        
        # Перемешиваем результат, чтобы гарантированные символы не были всегда в начале
        random.shuffle(password_chars)
        
        password = ''.join(password_chars)
        
        self.password_entry.config(state="normal")
        self.password_entry.delete(0, tk.END)
        self.password_entry.insert(0, password)
        self.password_entry.config(state="readonly")
        
        self.add_to_history(password)

    def copy_to_clipboard(self):
        """Копирует сгенерированный пароль в буфер обмена."""
        password = self.password_entry.get()
        if password:
            self.root.clipboard_clear()
            self.root.clipboard_append(password)
            messagebox.showinfo("Скопировано", "Пароль скопирован в буфер обмена.")

    # --- Методы GUI ---
    def create_widgets(self):
        main_frame = ttk.Frame(self.root, padding="15")
        main_frame.pack(fill="both", expand=True)

        # Панель настроек (Слева)
        settings_frame = ttk.LabelFrame(main_frame, text="Настройки генерации", padding="10")
        settings_frame.pack(side="left", fill="y")

        # Ползунок длины пароля
        ttk.Label(settings_frame, text="Длина пароля:").pack(anchor="w")
        
        length_frame = ttk.Frame(settings_frame)
        length_frame.pack(fill="x", pady=5)
        
        self.length_slider = tk.Scale(length_frame, from_=MIN_LENGTH, to=MAX_LENGTH, orient=tk.HORIZONTAL, length=250)
        self.length_slider.set(16) # Значение по умолчанию
        self.length_slider.pack(side="left")
        
        self.length_label = ttk.Label(length_frame, text=f"16 / {MAX_LENGTH}")
        self.length_label.pack(side="right")
        
        self.length_slider.config(command=lambda x: self.length_label.config(text=f"{x} / {MAX_LENGTH}"))

        # Чекбоксы для выбора символов (вкладка "Options")
        options_notebook = ttk.Notebook(settings_frame)
        
        options_frame = ttk.Frame(options_notebook)
        options_notebook.add(options_frame, text="Символы")
        
        options_notebook.pack(fill="x", pady=10)
        
        self.use_upper = tk.BooleanVar(value=True)
        ttk.Checkbutton(options_frame, text="Прописные (A-Z)", variable=self.use_upper).pack(anchor="w")
        
        self.use_lower = tk.BooleanVar(value=True)
        ttk.Checkbutton(options_frame, text="Строчные (a-z)", variable=self.use_lower).pack(anchor="w")
        
        self.use_digits = tk.BooleanVar(value=True)
        ttk.Checkbutton(options_frame, text="Цифры (0-9)", variable=self.use_digits).pack(anchor="w")
        
        self.use_punct = tk.BooleanVar(value=True)
        ttk.Checkbutton(options_frame, text="Знаки пунктуации (!@#)", variable=self.use_punct).pack(anchor="w")


         # Панель результата (Справа)
         result_frame = ttk.LabelFrame(main_frame, text="Результат", padding="10")
         result_frame.pack(side="right", fill="both", expand=True)

         # Поле с паролем и кнопка копирования
         entry_frame = ttk.Frame(result_frame)
         entry_frame.pack(fill="x", pady=5)
         
         ttk.Label(entry_frame, text="Ваш пароль:").pack(side="left")
         
         self.password_entry = ttk.Entry(entry_frame, width=40, state="readonly")
         self.password_entry.pack(side="left", expand=True, fill="x", padx=(5, 0))
         
         ttk.Button(entry_frame, text="Копировать", command=self.copy_to_clipboard).pack(side="right")
         
         # Кнопка генерации (по центру между панелями)
         ttk.Button(main_frame, text="Сгенерировать пароль", command=self.generate_password).pack(pady=20)
         
         # Панель истории (внизу справа)
         history_frame = ttk.LabelFrame(result_frame, text="История (последние 20)", padding="5")
         history_frame.pack(fill="both", expand=True, pady=(15, 0))
         
         history_scroll = ttk.Scrollbar(history_frame)
         history_scroll.pack(side="right", fill="y")
         
         self.history_listbox = tk.Listbox(history_frame, yscrollcommand=history_scroll.set, height=7, width=45)
         self.history_listbox.pack(fill="both", expand=True)
         
         history_scroll.config(command=self.history_listbox.yview)
         
         # Заполняем историю при запуске
         self.update_history_display()
         
    def update_history_display(self):
         """Обновляет виджет списка истории."""
         self.history_listbox.delete(0, tk.END)
         for entry in self.history:
             display_text = f"{entry['date']} - {entry['password']}"
             self.history_listbox.insert(tk.END, display_text)


# --- Точка входа ---
if __name__ == '__main__':
    root = tk.Tk()
    app = PasswordGeneratorApp(root)
    root.mainloop()
