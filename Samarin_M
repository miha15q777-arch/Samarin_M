import tkinter as tk
from tkinter import ttk, messagebox
import json
import os
import sys

# --- Настройки ---
DATA_FILE = "movies.json"
MIN_YEAR = 1888  # Год создания первого фильма
CURRENT_YEAR = 2026  # Обновите при необходимости

class MovieLibraryApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Личная кинотека")
        self.root.geometry("900x600")
        
        self.movies = []
        self.filtered_movies = []
        self.load_data()

        self.create_widgets()
        self.update_table()

    # --- Методы валидации ---
    def validate_title(self, title):
        if not title or title.strip() == "":
            raise ValueError("Поле 'Название' не может быть пустым.")
        return True

    def validate_genre(self, genre):
        if not genre or genre.strip() == "":
            raise ValueError("Поле 'Жанр' не может быть пустым.")
        return True

    def validate_year(self, year_str):
        try:
            year = int(year_str)
        except ValueError:
            raise ValueError("Поле 'Год' должно содержать целое число.")
        
        if year < MIN_YEAR or year > CURRENT_YEAR:
            raise ValueError(f"Год должен быть в диапазоне от {MIN_YEAR} до {CURRENT_YEAR}.")
        return True

    def validate_rating(self, rating_str):
        try:
            rating = float(rating_str)
        except ValueError:
            raise ValueError("Поле 'Рейтинг' должно быть числом (например, 8.5).")
        
        if rating < 0.0 or rating > 10.0:
            raise ValueError("Рейтинг должен быть в диапазоне от 0.0 до 10.0.")
        return True

    # --- Методы работы с данными ---
    def load_data(self):
        """Загрузка данных из JSON файла при запуске."""
        if os.path.exists(DATA_FILE):
            try:
                with open(DATA_FILE, 'r', encoding='utf-8') as f:
                    self.movies = json.load(f)
                self.filtered_movies = self.movies.copy()
                print("Данные успешно загружены из JSON.")
            except (json.JSONDecodeError, IOError) as e:
                messagebox.showerror("Ошибка данных", "Файл данных поврежден или недоступен. Будет создана новая база.")
                self.movies = []

    def save_data(self):
        """Сохранение данных в JSON файл."""
        try:
            with open(DATA_FILE, 'w', encoding='utf-8') as f:
                json.dump(self.movies, f, ensure_ascii=False, indent=4)
            print("Данные успешно сохранены в JSON.")
        except IOError as e:
            messagebox.showerror("Ошибка сохранения", "Не удалось сохранить данные. Проверьте права доступа к файлу.")

    # --- Методы логики приложения ---
    def add_movie(self):
        """Метод для добавления нового фильма с полной валидацией."""
        try:
            title = self.title_entry.get()
            self.validate_title(title)

            genre = self.genre_var.get()
            self.validate_genre(genre)

            year = self.year_entry.get()
            self.validate_year(year)

            rating = self.rating_entry.get()
            self.validate_rating(rating)

            # Если все проверки пройдены, добавляем фильм
            movie = {
                "title": title.strip(),
                "genre": genre.strip(),
                "year": int(year),
                "rating": float(rating)
            }
            
            self.movies.append(movie)
            self.filtered_movies.append(movie) # Добавляем и в отфильтрованный список
            
            self.save_data()
            self.update_table()
            
            # Очистка полей после успешного добавления
            self.title_entry.delete(0, tk.END)
            self.rating_entry.delete(0, tk.END)
            
            messagebox.showinfo("Успех", "Фильм успешно добавлен!")

        except ValueError as e:
            # Обработка ошибок валидации
            messagebox.showerror("Ошибка ввода", str(e))

    def apply_filter(self):
        """Метод для фильтрации списка фильмов."""
        filter_genre = self.filter_genre_var.get()
        filter_year_text = self.filter_year_entry.get()
        
        filtered_list = self.movies.copy()

        # Фильтрация по жанру
        if filter_genre != "Все":
            filtered_list = [m for m in filtered_list if m["genre"] == filter_genre]

        # Фильтрация по году
        if filter_year_text.strip() != "":
            try:
                filter_year = int(filter_year_text)
                if filter_year < MIN_YEAR or filter_year > CURRENT_YEAR:
                    raise ValueError
                filtered_list = [m for m in filtered_list if m["year"] == filter_year]
            except ValueError:
                messagebox.showerror("Ошибка фильтра", f"Поле 'Год' для фильтрации должно быть целым числом от {MIN_YEAR} до {CURRENT_YEAR}.")
                return # Останавливаем выполнение, если год неверный

        self.filtered_movies = filtered_list
        self.update_table()

    # --- Методы GUI ---
    def create_widgets(self):
        # ... (код создания виджетов из предыдущего ответа остается без изменений)
        # Здесь он для полноты картины, но в реальном файле он будет над методом __init__
        
    def update_table(self):
        """Очищает и обновляет таблицу данными из self.filtered_movies."""
        for i in self.tree.get_children():
            self.tree.delete(i)

        for movie in self.filtered_movies:
            self.tree.insert("", "end", values=(
                movie["title"],
                movie["genre"],
                movie["year"],
                movie["rating"]
            ))

# --- Точка входа ---
if __name__ == '__main__':
    root = tk.Tk()
    app = MovieLibraryApp(root)
    root.mainloop()
