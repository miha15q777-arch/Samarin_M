import tkinter as tk
from tkinter import ttk, messagebox, simpledialog
import json
import os
import requests

# --- Настройки ---
API_URL = "https://api.github.com/search/users"
FAVORITES_FILE = "users.json"
HEADERS = {'Accept': 'application/vnd.github.v3+json'} # Рекомендуемый заголовок для GitHub API

class GitHubUserFinderApp:
    def __init__(self, root):
        self.root = root
        self.root.title("GitHub User Finder")
        self.root.geometry("900x600")
        
        self.favorites = self.load_favorites()
        self.create_widgets()

    # --- Работа с избранным (JSON) ---
    def load_favorites(self):
        """Загрузка избранных пользователей из файла."""
        if os.path.exists(FAVORITES_FILE):
            try:
                with open(FAVORITES_FILE, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except (json.JSONDecodeError, IOError):
                return []
        return []

    def save_favorites(self):
        """Сохранение избранных пользователей в файл."""
        try:
            with open(FAVORITES_FILE, 'w', encoding='utf-8') as f:
                json.dump(self.favorites, f, ensure_ascii=False, indent=4)
        except IOError as e:
            messagebox.showerror("Ошибка сохранения", "Не удалось сохранить список избранного.")

    def is_in_favorites(self, username):
        """Проверка, есть ли пользователь в избранном."""
        return any(user.get('login') == username for user in self.favorites)

    # --- Методы API и логики ---
    def search_users(self):
        """Выполняет поиск пользователей по введенному запросу."""
        query = self.search_entry.get().strip()
        
        # Валидация ввода
        if not query:
            messagebox.showwarning("Введите запрос", "Поле поиска не может быть пустым.")
            return

        try:
            params = {'q': query}
            response = requests.get(API_URL, headers=HEADERS, params=params, timeout=10)
            
            # Обработка статус-кодов
            if response.status_code == 200:
                data = response.json()
                users = data.get('items', [])
                self.update_results(users)
            elif response.status_code == 403:
                # Часто это ошибка лимита запросов (rate limit) для неавторизованных пользователей
                messagebox.showerror("Ошибка API", "Превышен лимит запросов к GitHub API. Попробуйте позже.")
            elif response.status_code == 422:
                messagebox.showerror("Ошибка запроса", "Неверный формат запроса.")
            else:
                messagebox.showerror("Ошибка API", f"Неизвестная ошибка. Статус-код: {response.status_code}")
                
        except requests.exceptions.RequestException as e:
            # Обработка сетевых ошибок (нет интернета, таймаут и т.д.)
            messagebox.showerror("Сетевая ошибка", f"Не удалось подключиться к серверу. Проверьте интернет-соединение.\n{str(e)}")

    # --- Методы GUI ---
    def create_widgets(self):
        # Верхняя панель: Поиск
        top_frame = ttk.Frame(self.root)
        top_frame.pack(fill="x", padx=10, pady=5)

        self.search_entry = ttk.Entry(top_frame, width=50)
        self.search_entry.pack(side="left", expand=True, fill="x", padx=(0, 5))
        self.search_entry.bind("<Return>", lambda event: self.search_users()) # Поиск по Enter

        ttk.Button(top_frame, text="Найти", command=self.search_users).pack(side="left")

        # Таблица с результатами и контекстным меню
        self.columns = ("login", "id", "type")
        self.tree = ttk.Treeview(self.root, columns=self.columns, show="headings")
        
        self.tree.heading("login", text="Логин")
        self.tree.heading("id", text="ID")
        self.tree.heading("type", text="Тип")
        
        self.tree.column("login", width=200)
        self.tree.column("id", width=80)
        
        # Полосы прокрутки
        yscrollbar = ttk.Scrollbar(self.root, orient="vertical", command=self.tree.yview)
        xscrollbar = ttk.Scrollbar(self.root, orient="horizontal", command=self.tree.xview)
        
        self.tree.configure(yscroll=yscrollbar.set, xscroll=xscrollbar.set)
        
        self.tree.pack(fill="both", expand=True, padx=10, pady=5)
        
        # Привязка правой кнопки мыши
        self.tree.bind("<Button-3>", self.show_context_menu)

    def update_results(self, users_data):
        """Очищает и обновляет таблицу результатами поиска."""
        for i in self.tree.get_children():
            self.tree.delete(i)

        for user in users_data:
            login = user.get('login', '')
            user_id = user.get('id', '')
            user_type = user.get('type', '')
            
            # Добавляем теги для цвета фона избранных пользователей
            tags = ()
            if self.is_in_favorites(login):
                tags = ("favorite",)
            
            self.tree.insert("", "end", values=(login, user_id, user_type), tags=tags)
        
        # Настройка цвета для избранных
        self.tree.tag_configure('favorite', background='#d1e7dd') # Светло-зеленый

    def show_context_menu(self, event):
        """Отображает меню при клике правой кнопкой мыши на строку."""
        item = self.tree.identify_row(event.y)
        if not item:
            return # Клик был не по строке

        # Выбираем строку
        self.tree.selection_set(item)
        
        # Создаем меню
        menu = tk.Menu(self.root, tearoff=0)
        
        values = self.tree.item(item, "values")
        if not values:
            return
            
        username = values[0]
        
        if self.is_in_favorites(username):
            menu.add_command(label="Удалить из избранного", command=lambda: self.remove_from_favorites(username))
        else:
            menu.add_command(label="Добавить в избранное", command=lambda: self.add_to_favorites(username))
        
        try:
            menu.tk_popup(event.x_root, event.y_root)
        finally:
            menu.grab_release()

    def add_to_favorites(self, username):
        """Добавляет пользователя в избранное."""
        if not messagebox.askyesno("Подтверждение", f"Добавить пользователя '{username}' в избранное?"):
            return

        # Получаем полные данные пользователя для сохранения (поиск по логину)
        try:
            response = requests.get(f"https://api.github.com/users/{username}", headers=HEADERS)
            if response.status_code == 200:
                user_data = response.json()
                self.favorites.append(user_data)
                self.save_favorites()
                messagebox.showinfo("Успех", f"Пользователь '{username}' добавлен в избранное.")
                self.update_results(self.get_current_search_results()) # Обновляем цвет строки
            else:
                messagebox.showerror("Ошибка", "Не удалось получить данные пользователя для добавления в избранное.")
                
        except requests.exceptions.RequestException as e:
             messagebox.showerror("Сетевая ошибка", f"Ошибка при добавлении в избранное.\n{str(e)}")

    def remove_from_favorites(self, username):
        """Удаляет пользователя из избранного."""
        if not messagebox.askyesno("Подтверждение", f"Удалить пользователя '{username}' из избранного?"):
            return

        initial_count = len(self.favorites)
        self.favorites = [user for user in self.favorites if user.get('login') != username]
        
        if len(self.favorites) < initial_count:
            self.save_favorites()
            messagebox.showinfo("Успех", f"Пользователь '{username}' удален из избранного.")
            self.update_results(self.get_current_search_results()) # Обновляем цвет строки
            
    def get_current_search_results(self):
        """Вспомогательный метод для получения текущих данных в таблице."""
        results = []
        for child in self.tree.get_children():
            values = self.tree.item(child, "values")
            if values:
                results.append({'login': values[0], 'id': values[1], 'type': values[2]})
        return results

# --- Точка входа ---
if __name__ == '__main__':
    root = tk.Tk()
    app = GitHubUserFinderApp(root)
    root.mainloop()
